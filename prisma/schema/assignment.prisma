enum Difficulty {
  beginner
  intermediate
  advanced
}

model Assignment {
  id          String     @id @default(cuid())
  title       String
  description String
  deadline    DateTime
  difficulty  Difficulty
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  archivedAt  DateTime?  // null = active; set = soft-deleted

  instructor  User         @relation(fields: [createdBy], references: [id])
  submissions Submission[]
}
